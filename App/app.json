{
  "expo": {
    "name": "Daryeel Health",
    "slug": "daryeel-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daryeelhealth",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.engkhadareid.daryeelhealth",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Daryeel Health uses motion data to count your steps automatically in Health Daily."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF2FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.engkhadareid.daryeelhealth",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sensors",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#146AFB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://daryeel-healthtech-api.vercel.app/api/v1",
      "router": {},
      "eas": {
        "projectId": "96ebcede-0846-49c7-87bb-33e4d5f34393"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/96ebcede-0846-49c7-87bb-33e4d5f34393"
    }
  }
}