    "eas:ios:dev": "eas build -p ios --profile development",
    "eas:android:dev": "eas build -p android --profile development",
    "eas:submit:android": "eas submit -p android --profile production",
    "eas:submit:ios": "eas submit -p ios --profile production",
    "eas:update:preview": "eas update --channel preview",
    "eas:update:production": "eas update --channel production"
