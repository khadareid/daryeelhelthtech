# Healthtech API
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/daryeel_healthtech
SESSION_SECRET=replace-me
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
CSRF_SECRET=replace-me

# Daryeel SaaS integration (server-to-server only — never expose to mobile/web)
SAAS_API_URL=http://localhost:5000/api/v1
SAAS_INTEGRATION_KEY=replace-with-shared-integration-key
SAAS_WEBHOOK_SECRET=replace-with-webhook-secret

FRONTEND_URL=https://daryeel-healthtech-gamma.vercel.app
# Optional comma-separated extra browser origins allowed by CORS
CORS_ORIGINS=https://daryeel-healthtech-gamma.vercel.app,http://localhost:5173
