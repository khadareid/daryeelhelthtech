# Healthtech API
PORT=5000
NODE_ENV=development
# Neon: use the -pooler host. Prisma adds pgbouncer/connection_limit if missing.
# Example: ...@ep-xxx-pooler....neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=8&pool_timeout=30
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/daryeel_healthtech?sslmode=require
SESSION_SECRET=replace-me
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
CSRF_SECRET=replace-me

# Daryeel SaaS integration (server-to-server only — NEVER put these in Vite/Expo)
# Point at the SaaS API base including /api/v1
SAAS_API_URL=http://localhost:5001/api/v1
SAAS_INTEGRATION_KEY=replace-with-shared-integration-key
SAAS_WEBHOOK_SECRET=replace-with-webhook-secret

FRONTEND_URL=https://daryeel-healthtech-gamma.vercel.app
# Optional comma-separated extra browser origins allowed by CORS
CORS_ORIGINS=https://daryeel-healthtech-gamma.vercel.app,http://localhost:5173
