# Healthtech API
PORT=5000
NODE_ENV=development
# Neon: use the -pooler host. Prisma adds pgbouncer/connection_limit if missing.
# Example: ...@ep-xxx-pooler....neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=8&pool_timeout=30
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/daryeel_healthtech?sslmode=require
SESSION_SECRET=replace-me
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
CSRF_SECRET=replace-me

# Daryeel SaaS integration (server-to-server only — NEVER put these in Vite/Expo)
# Production SaaS API: https://daryeelsaashealthtech-api-seven.vercel.app/api/v1
SAAS_API_URL=https://daryeelsaashealthtech-api-seven.vercel.app/api/v1
# Must match SaaS HEALTHTECH_INTEGRATION_KEY (same value on both Vercel projects)
SAAS_INTEGRATION_KEY=daryeel-healthtech-saas-shared-2026
SAAS_WEBHOOK_SECRET=daryeel-healthtech-webhook-shared-2026

# Production website: https://daryeelhelthtech.vercel.app
# Production API:     https://daryeelhelthtech-api.vercel.app
FRONTEND_URL=https://daryeelhelthtech.vercel.app
# Optional comma-separated extra browser origins allowed by CORS
CORS_ORIGINS=https://daryeelhelthtech.vercel.app,https://daryeel-saas-healthtech-six.vercel.app,http://localhost:5173
