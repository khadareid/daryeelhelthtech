generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

// ======================================================
// APPOINTMENT
// ======================================================

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULE_REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  LOCAL
  HEALTHTECH
}

enum HospitalPaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_PAID
  WAIVED
  REFUNDED
}

// ======================================================
// CONSULTATION
// ======================================================

enum ConsultationType {
  VIDEO
  AUDIO
  CHAT
  IN_PERSON
}

enum ConsultationStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ======================================================
// PAYMENT
// ======================================================

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  WALLET
  ONLINE
  OTHER
}

// ======================================================
// NOTIFICATION
// ======================================================

enum NotificationType {
  APPOINTMENT
  APPOINTMENT_REMINDER
  APPOINTMENT_ACCEPTED
  APPOINTMENT_REJECTED
  CONSULTATION
  PAYMENT
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  MEDICAL_RECORD
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

// ======================================================
// WELLNESS
// ======================================================

enum MoodLevel {
  VERY_BAD
  BAD
  NEUTRAL
  GOOD
  VERY_GOOD
}

enum SleepQuality {
  VERY_POOR
  POOR
  FAIR
  GOOD
  EXCELLENT
}

enum StressLevel {
  NONE
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum EnergyLevel {
  VERY_LOW
  LOW
  NORMAL
  HIGH
  VERY_HIGH
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum PainLevel {
  NONE
  MILD
  MODERATE
  SEVERE
  VERY_SEVERE
}

enum HydrationStatus {
  NOT_MET
  PARTIAL
  MET
  EXCEEDED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DailyLogSource {
  MANUAL
  HEALTH_CONNECT
  DEVICE
  MIXED
}

// ======================================================
// DOCTOR
// ======================================================

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// ======================================================
// ACCESS / PRIVACY
// ======================================================

enum ConsentStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum AccessLevel {
  VIEW
  DOWNLOAD
  FULL
}

enum AccessRequestType {
  MEDICAL_RECORD
  VITALS
  MEDICATIONS
  LAB_RESULTS
  PRESCRIPTIONS
  FULL_RECORD
}

// ======================================================
// AUDIT
// ======================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
  SHARE
  REVOKE
  APPROVE
  REJECT
  PAYMENT
  REFUND
}

// ======================================================
// 1. USER
// ======================================================

model User {
  userid       String  @id @default(cuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String?

  fullName    String
  gender      Gender?
  dateOfBirth DateTime?
  avatarUrl   String?

  // Personal Health ID
  healthId String? @unique

  // Google Login
  googleId String? @unique
  picture  String?

  role        Role    @default(USER)
  isActive    Boolean @default(true)
  isSuspended Boolean @default(false)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  language String @default("so")
  timezone String @default("Africa/Mogadishu")

  country  String? @default("Somaliland")
  region   String?
  city     String?
  district String?

  lastLoginAt DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ====================================================
  // RELATIONS
  // ====================================================

  medicalProfile MedicalProfile?

  emergencyContacts EmergencyContact[]
  emergencyCard     EmergencyCard?

  familyMembers       FamilyMember[] @relation("FamilyOwner")
  linkedFamilyMembers FamilyMember[] @relation("FamilyLinkedUser")

  allergies         Allergy[]
  chronicConditions ChronicCondition[]
  medications       Medication[]

  medicalRecords   MedicalRecord[]
  medicalDocuments MedicalDocument[]
  diagnoses        Diagnosis[]
  vitalSigns       VitalSign[]
  labResults       LabResult[]

  prescriptions Prescription[]

  dailyHealthLogs         DailyHealthLog[]
  healthDeviceConnections HealthDeviceConnection[]

  doctor Doctor?

  appointments  Appointment[]
  consultations Consultation[]
  doctorReviews DoctorReview[]

  payments Payment[]

  notifications Notification[]
  healthcareActivityEvents HealthcareActivityEvent[]

  consents Consent[]

  accessRequestsSent     MedicalAccessRequest[] @relation("AccessRequester")
  accessRequestsReceived MedicalAccessRequest[] @relation("AccessPatient")

  auditLogs AuditLog[]

  suspensionReason String?
  suspendedUntil   DateTime?
  suspendedBy      String?
  suspendedAt      DateTime?
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?
  passwordChangedAt      DateTime?
  lastActiveAt           DateTime?
  lastLoginIp            String?
  deletedBy              String?
  deletedReason          String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  recoveryCodes    String[] @default([])
  sessions               UserSession[]
  adminActions           AdminAction[]            @relation("AdminActions")
  broadcasts             BroadcastMessage[]
  userRoles              UserRole[]
  doctorDocuments        DoctorDocument[]         @relation("DoctorDocumentUploader")
  verificationLogs       DoctorVerificationLog[]
  assignedUserRoles      UserRole[]               @relation("RoleAssigner")

  @@index([role])
  @@index([isActive])
  @@index([healthId])
  @@index([isSuspended])
  @@index([lastActiveAt])
}

// ======================================================
// 2. MEDICAL PROFILE
// ======================================================

model MedicalProfile {
  id     String @id @default(cuid())
  userId String @unique

  bloodType BloodType @default(UNKNOWN)

  smokingStatus     String?
  alcoholUse        String?
  exerciseFrequency String?
  dietType          String?

  familyHistory   Json?
  surgicalHistory Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)
}

// ======================================================
// 3. EMERGENCY CONTACT
// ======================================================

model EmergencyContact {
  id             String  @id @default(cuid())
  userId         String
  fullName       String
  relationship   String
  phone          String
  alternatePhone String?
  email          String?
  isPrimary      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
}

// ======================================================
// 4. EMERGENCY CARD
// ======================================================

model EmergencyCard {
  id     String @id @default(cuid())
  userId String @unique

  cardNumber String @unique

  bloodType BloodType @default(UNKNOWN)

  emergencyContactName  String?
  emergencyContactPhone String?

  allergiesSummary   String?
  conditionsSummary  String?
  medicationsSummary String?

  doctorNotes String?

  qrCode String?

  isActive Boolean @default(true)

  lastUpdatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userid], onDelete: Cascade)
}

// ======================================================
// 5. FAMILY MEMBER
// ======================================================

model FamilyMember {
  id     String @id @default(cuid())
  userId String

  // If family member has Daryeel account
  linkedUserId String?

  fullName     String
  relationship String

  dateOfBirth DateTime?
  gender      Gender?
  phone       String?

  isDependent Boolean @default(false)

  canManageHealthRecords Boolean @default(false)
  canBookAppointments    Boolean @default(false)
  canViewMedicalRecords  Boolean @default(false)

  isEmergencyContact Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("FamilyOwner", fields: [userId], references: [userid], onDelete: Cascade)

  linkedUser User? @relation("FamilyLinkedUser", fields: [linkedUserId], references: [userid], onDelete: SetNull)

  @@index([userId])
  @@index([linkedUserId])
}

// ======================================================
// 6. ALLERGY
// ======================================================

model Allergy {
  id     String @id @default(cuid())
  userId String

  allergen    String
  type        String?
  severity    String?
  reaction    String?
  diagnosedAt DateTime?

  isActive Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ======================================================
// 7. CHRONIC CONDITION
// ======================================================

model ChronicCondition {
  id     String @id @default(cuid())
  userId String

  condition   String
  icdCode     String?
  diagnosedAt DateTime?
  severity    String?

  isActive     Boolean @default(true)
  isControlled Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ======================================================
// 8. MEDICATION
// ======================================================

model Medication {
  id     String @id @default(cuid())
  userId String

  name      String
  dosage    String?
  frequency String?
  route     String?

  startedAt DateTime?
  endedAt   DateTime?

  isActive Boolean @default(true)

  prescribedBy String?
  reason       String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ======================================================
// 9. MEDICAL RECORD
// ======================================================

model MedicalRecord {
  id     String @id @default(cuid())
  userId String

  recordType String
  title      String

  description String?
  diagnosis   String?
  treatment   String?

  doctorName   String?
  facilityName String?

  recordDate DateTime

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  documents MedicalDocument[]

  @@index([userId, recordDate])
}

// ======================================================
// 10. MEDICAL DOCUMENT
// ======================================================

model MedicalDocument {
  id     String @id @default(cuid())
  userId String

  medicalRecordId String?

  title        String
  documentType String

  fileUrl  String
  fileName String?
  mimeType String?
  fileSize Int?

  description String?

  documentDate DateTime?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([medicalRecordId])
}

// ======================================================
// 11. DIAGNOSIS
// ======================================================

model Diagnosis {
  id     String @id @default(cuid())
  userId String

  doctorId       String?
  appointmentId  String?
  consultationId String?

  diagnosis String
  icdCode   String?

  description String?

  diagnosedAt DateTime @default(now())

  isPrimary Boolean @default(false)

  status String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([doctorId])
  @@index([appointmentId])
  @@index([consultationId])
}

// ======================================================
// 12. VITAL SIGN
// ======================================================

model VitalSign {
  id     String @id @default(cuid())
  userId String

  temperature      Float?
  bloodPressureSys Int?
  bloodPressureDia Int?
  heartRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?

  weight Float?
  height Float?
  bmi    Float?

  source     String   @default("MANUAL")
  recordedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId, recordedAt])
}

// ======================================================
// 13. LAB RESULT
// ======================================================

model LabResult {
  id     String @id @default(cuid())
  userId String

  doctorId      String?
  appointmentId String?

  testName String
  testCode String?
  category String?

  resultValue    String?
  unit           String?
  referenceRange String?

  status         String?
  interpretation String?

  labName String?

  resultDate DateTime

  documentUrl String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, resultDate])
  @@index([doctorId])
  @@index([appointmentId])
}

// ======================================================
// 14. PRESCRIPTION
// ======================================================

model Prescription {
  id     String @id @default(cuid())
  userId String

  doctorId       String?
  appointmentId  String?
  consultationId String?

  prescriptionNumber String @unique

  issuedAt DateTime @default(now())

  startDate DateTime?
  endDate   DateTime?

  status String @default("ACTIVE")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  items PrescriptionItem[]

  @@index([userId])
  @@index([doctorId])
  @@index([appointmentId])
  @@index([consultationId])
}

// ======================================================
// 15. PRESCRIPTION ITEM
// ======================================================

model PrescriptionItem {
  id String @id @default(cuid())

  prescriptionId String

  medicineName String
  dosage       String?
  frequency    String?
  route        String?
  duration     String?
  quantity     String?

  instructions String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

// ======================================================
// 16. DAILY HEALTH LOG
// ======================================================

model DailyHealthLog {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  mood          MoodLevel?
  sleepQuality  SleepQuality?
  stressLevel   StressLevel?
  energyLevel   EnergyLevel?
  activityLevel ActivityLevel?
  painLevel     PainLevel?

  notes String?

  // Activity
  steps          Int   @default(0)
  distanceKm     Float @default(0)
  activeMinutes  Int   @default(0)
  caloriesBurned Int   @default(0)

  // Heart
  heartRateAvg Int?
  heartRateMin Int?
  heartRateMax Int?

  // Body
  weightKg       Float?
  bodyFatPercent Float?
  bmi            Float?

  // Oxygen
  oxygenSaturation Float?

  // Hydration
  waterIntakeMl   Int             @default(0)
  waterGoalMl     Int             @default(2000)
  hydrationStatus HydrationStatus @default(NOT_MET)

  // Sleep
  sleepHours Float?
  sleepStart DateTime?
  sleepEnd   DateTime?

  // Goals
  stepsGoal       Int        @default(10000)
  stepsGoalStatus GoalStatus @default(NOT_STARTED)

  waterGoalStatus GoalStatus @default(NOT_STARTED)

  activeMinutesGoal Int        @default(30)
  activeGoalStatus  GoalStatus @default(NOT_STARTED)

  sleepGoalHours  Float      @default(8)
  sleepGoalStatus GoalStatus @default(NOT_STARTED)

  // Source
  source     DailyLogSource @default(MANUAL)
  deviceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ======================================================
// 17. HEALTH DEVICE CONNECTION
// ======================================================

model HealthDeviceConnection {
  id     String @id @default(cuid())
  userId String

  provider   String
  deviceName String?

  providerUserId String?

  // Store encrypted values only
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?

  tokenExpiresAt DateTime?

  scopes String[] @default([])

  isActive Boolean @default(true)

  lastSyncAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
}

// ======================================================
// 18. DOCTOR
// ======================================================

model Doctor {
  id     String @id @default(cuid())
  userId String @unique

  fullName     String
  profileImage String?

  gender          Gender?
  specialty       String
  subSpecialty    String?
  qualification   String?
  university      String?
  yearsExperience Int?
  bio             String?

  languages String[] @default([])

  licenseNumber    String?
  licenseAuthority String?

  verificationStatus DoctorVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?

  consultationEnabled      Boolean @default(true)
  videoConsultationEnabled Boolean @default(false)
  chatConsultationEnabled  Boolean @default(false)

  consultationFee      Decimal? @db.Decimal(10, 2)
  videoConsultationFee Decimal? @db.Decimal(10, 2)
  chatConsultationFee  Decimal? @db.Decimal(10, 2)

  currency String @default("USD")

  isAvailable Boolean @default(true)
  isOnline    Boolean @default(false)
  isActive    Boolean @default(true)

  clinicName String?
  city       String?
  country    String?

  rating      Decimal? @db.Decimal(3, 2)
  reviewCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  appointments  Appointment[]
  consultations Consultation[]

  diagnoses     Diagnosis[]
  labResults    LabResult[]
  prescriptions Prescription[]

  doctorReviews DoctorReview[]

  verifiedBy           String?
  rejectedBy           String?
  rejectedAt           DateTime?
  suspendedReason      String?
  suspendedUntil       DateTime?
  suspendedBy          String?
  submittedForReviewAt DateTime?
  reviewNotes          String?
  documents            DoctorDocument[]
  verificationLogs     DoctorVerificationLog[]

  @@index([specialty])
  @@index([verificationStatus])
  @@index([isAvailable])
  @@index([isActive])
  @@index([verifiedBy])
}

// ======================================================
// 19. APPOINTMENT
// ======================================================

model Appointment {
  id       String  @id @default(cuid())
  userId   String
  doctorId String?

  appointmentCode String @unique

  scheduledAt DateTime
  duration    Int      @default(30)

  reason String?
  notes  String?

  status AppointmentStatus @default(PENDING)
  source AppointmentSource @default(LOCAL)

  meetingLink String?

  // ====================================================
  // SAAS / EXTERNAL REFERENCES (no duplicated hospital DB)
  // ====================================================

  externalAppointmentId String? @unique
  externalHospitalId    String?
  externalFacilityId    String?
  externalDepartmentId  String?
  externalDoctorId      String?
  externalTicketId      String?
  externalTicketNumber  String?
  externalVisitId       String?
  externalRequestId     String?
  idempotencyKey        String? @unique
  consentId             String?

  doctorName    String?
  facilityName  String?
  specialty     String?
  department    String?

  proposedScheduledAt DateTime?
  proposedMessage     String?
  rejectionReason     String?

  hospitalPaymentStatus HospitalPaymentStatus @default(UNPAID)

  // ====================================================
  // PAYMENT
  // ====================================================

  paymentRequired Boolean @default(true)

  consultationFee Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")

  paymentStatus PaymentStatus @default(PENDING)

  // ====================================================
  // REMINDER
  // ====================================================

  reminderSent Boolean   @default(false)
  reminderAt   DateTime?

  // ====================================================
  // TIMESTAMPS
  // ====================================================

  requestedAt DateTime  @default(now())
  confirmedAt DateTime?

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ====================================================
  // RELATIONS
  // ====================================================

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  payments Payment[]

  consultation Consultation?

  diagnoses     Diagnosis[]
  labResults    LabResult[]
  prescriptions Prescription[]

  doctorReviews DoctorReview[]

  healthcareActivityEvents HealthcareActivityEvent[]

  @@index([userId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([source])
  @@index([externalHospitalId])
  @@index([externalDoctorId])
  @@index([externalAppointmentId])
}

// ======================================================
// 20. CONSULTATION
// ======================================================

model Consultation {
  id String @id @default(cuid())

  consultationCode String @unique

  userId   String
  doctorId String?

  appointmentId String? @unique

  type   ConsultationType
  status ConsultationStatus @default(SCHEDULED)

  scheduledAt DateTime?

  startedAt DateTime?
  endedAt   DateTime?

  meetingLink String?

  summary          String?
  diagnosisSummary String?
  treatmentPlan    String?

  patientNotes String?
  doctorNotes  String?

  followUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  diagnoses Diagnosis[]

  prescriptions Prescription[]

  @@index([userId])
  @@index([doctorId])
  @@index([status])
}

// ======================================================
// 21. DOCTOR REVIEW
// ======================================================

model DoctorReview {
  id String @id @default(cuid())

  userId   String
  doctorId String?

  appointmentId String?

  rating Int

  review String?

  isAnonymous Boolean @default(false)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([userId])
  @@index([appointmentId])
}

// ======================================================
// 22. PAYMENT
// ======================================================

model Payment {
  id String @id @default(cuid())

  appointmentId String?
  userId        String

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  status PaymentStatus  @default(PENDING)
  method PaymentMethod?

  // Transaction references
  transactionId         String? @unique
  paymentReference      String? @unique
  externalTransactionId String? @unique

  provider String?

  providerResponse Json?

  // Refund
  refundedAmount  Decimal?  @db.Decimal(10, 2)
  refundedAt      DateTime?
  refundReference String?
  refundReason    String?

  // Failure
  failureCode   String?
  failureReason String?

  initiatedAt DateTime  @default(now())
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([appointmentId])
  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([provider])
  @@index([createdAt])
}

// ======================================================
// 23. NOTIFICATION
// ======================================================

model Notification {
  id     String @id @default(cuid())
  userId String

  title String
  body  String

  type    NotificationType
  channel NotificationChannel @default(IN_APP)

  isRead Boolean   @default(false)
  readAt DateTime?

  data Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
}

// ======================================================
// 24. CONSENT
// ======================================================

model Consent {
  id     String @id @default(cuid())
  userId String

  requesterId String?

  doctorId     String?
  hospitalId   String?
  hospitalName String?

  accessLevel AccessLevel
  status      ConsentStatus @default(PENDING)

  expiresAt DateTime?
  grantedAt DateTime?
  revokedAt DateTime?
  revokedReason String?

  medicalRecords    Boolean @default(false)
  vitalSigns        Boolean @default(false)
  medications       Boolean @default(false)
  allergies         Boolean @default(false)
  chronicConditions Boolean @default(false)
  labResults        Boolean @default(false)
  prescriptions     Boolean @default(false)
  appointments      Boolean @default(false)

  purpose String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([requesterId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([status])
}

// ======================================================
// 25. MEDICAL ACCESS REQUEST
// ======================================================

model MedicalAccessRequest {
  id String @id @default(cuid())

  requesterId String
  patientId   String

  requestType AccessRequestType

  status ConsentStatus @default(PENDING)

  message String?

  requestedAt DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?

  requester User @relation("AccessRequester", fields: [requesterId], references: [userid], onDelete: Cascade)

  patient User @relation("AccessPatient", fields: [patientId], references: [userid], onDelete: Cascade)

  @@index([requesterId])
  @@index([patientId])
  @@index([status])
}

// ======================================================
// 26. AUDIT LOG
// ======================================================

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action AuditAction

  entity   String
  entityId String?

  description String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [userid], onDelete: SetNull)

  requestId  String?
  sessionId  String?
  method     String?
  path       String?
  statusCode Int?
  durationMs Int?
  severity   String? @default("INFO")
  changes    Json?

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

// ======================================================
// 27. PLATFORM SETTINGS & RBAC (admin / superadmin powers)
// Note: model is PlatformRole — enum Role already exists on User
// ======================================================

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  category    String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0)
  targetRoles    String[] @default([])
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PlatformRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            UserRole[]
  broadcastTargets BroadcastMessage[] @relation("BroadcastTargetRole")

  @@map("roles")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?

  user     User          @relation(fields: [userId], references: [userid], onDelete: Cascade)
  role     PlatformRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User?         @relation("RoleAssigner", fields: [assignedBy], references: [userid], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  deviceType   String?
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime?
  revokedBy    String?
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([isRevoked])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([success])
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  actionType String
  targetType String?
  targetId   String?
  reason     String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActions", fields: [adminId], references: [userid], onDelete: Cascade)

  @@index([adminId])
  @@index([actionType])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model BroadcastMessage {
  id            String                @id @default(cuid())
  createdBy     String
  title         String
  body          String
  channel       NotificationChannel[] @default([IN_APP])
  targetRoleId  String?
  targetUserIds String[]              @default([])
  scheduledAt   DateTime?
  sentAt        DateTime?
  status        String                @default("DRAFT")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  creator    User          @relation(fields: [createdBy], references: [userid], onDelete: Cascade)
  targetRole PlatformRole? @relation("BroadcastTargetRole", fields: [targetRoleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduledAt])
  @@index([targetRoleId])
}

model DoctorDocument {
  id              String    @id @default(cuid())
  doctorId        String
  type            String
  fileUrl         String
  fileName        String?
  mimeType        String?
  fileSize        Int?
  isVerified      Boolean   @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  uploadedBy      String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  uploader User?  @relation("DoctorDocumentUploader", fields: [uploadedBy], references: [userid], onDelete: SetNull)

  @@index([doctorId])
  @@index([isVerified])
  @@index([type])
}

model DoctorVerificationLog {
  id        String   @id @default(cuid())
  doctorId  String
  adminId   String
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  admin  User   @relation(fields: [adminId], references: [userid], onDelete: Cascade)

  @@index([doctorId])
  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

model EmergencyCardScan {
  id        String   @id @default(cuid())
  cardId    String
  scannedBy String?
  ipAddress String?
  userAgent String?
  location  String?
  scannedAt DateTime @default(now())

  @@index([cardId])
  @@index([scannedAt])
}

// ======================================================
// HEALTHCARE INTEGRATION ACTIVITY (lightweight audit)
// ======================================================

model HealthcareActivityEvent {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?
  type          String
  title         String
  body          String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [userid], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([appointmentId])
  @@index([type])
}
