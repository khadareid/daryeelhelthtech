generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN
  USER
  PATIENT
  DOCTOR
  NURSE
  MIDWIFE
  LAB_TECH
  PHARMACIST
  RECEPTIONIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum ConsentScope {
  MEDICAL_RECORDS
  APPOINTMENTS
  LAB_RESULTS
  PRESCRIPTIONS
  VITAL_SIGNS
  ALL
}

enum ConsentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
  EXPIRED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum HealthTrackingType {
  BLOOD_PRESSURE
  BLOOD_SUGAR
  WEIGHT
  HEIGHT
  HEART_RATE
  TEMPERATURE
  OXYGEN_SATURATION
  STEPS
  SLEEP
  WATER_INTAKE
  MOOD
  PAIN_LEVEL
  CUSTOM
}

enum NotificationType {
  APPOINTMENT_REMINDER
  LAB_RESULT
  PRESCRIPTION
  SYSTEM
  PAYMENT
  HEALTH_TIP
  CONSENT_REQUEST
  PROFESSIONAL_APPLICATION
  NEWS_INTERACTION
  MODERATION
  CONNECTION
  MESSAGE
  APPOINTMENT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
  ENDED
}

enum ConnectionRequestedBy {
  PATIENT
  PROFESSIONAL
}

enum NotificationChannel {
  SMS
  PUSH
  EMAIL
  IN_APP
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  COMMISSION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  CASH
  CARD
  MOBILE_MONEY
}

enum MoodLevel {
  VERY_BAD
  BAD
  NEUTRAL
  GOOD
  VERY_GOOD
}

enum SleepQuality {
  VERY_POOR
  POOR
  FAIR
  GOOD
  EXCELLENT
}

enum StressLevel {
  NONE
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum EnergyLevel {
  VERY_LOW
  LOW
  NORMAL
  HIGH
  VERY_HIGH
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum PainLevel {
  NONE
  MILD
  MODERATE
  SEVERE
  VERY_SEVERE
}

enum HydrationStatus {
  NOT_MET
  PARTIAL
  MET
  EXCEEDED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DailyLogSource {
  MANUAL
  DEVICE
  HEALTH_APP
  MIXED
}

// ═══════════════════════════════════════════════════════════
// 1. USER
// ═══════════════════════════════════════════════════════════

model User {
  userid       String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String?
  fullName     String
  gender       Gender?
  dateOfBirth  DateTime?
  avatarUrl    String?
  isDeleted    Boolean   @default(false)

  googleId  String?   @unique
  picture   String?
  lastLogin DateTime?
  role      Role      @default(USER)

  emailVerified    Boolean @default(false)
  phoneVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  language String @default("so")
  timezone String @default("Africa/Mogadishu")

  isActive    Boolean   @default(true)
  isSuspended Boolean   @default(false)
  lastLoginAt DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile              UserProfile?
  medicalProfile       MedicalProfile?
  professionalProfiles ProfessionalProfile[]

  healthRecords MedicalRecord[]
  vitalSigns    VitalSign[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  labResults    LabResult[]
  appointments  Appointment[]
  documents     Document[]

  emergencyContacts EmergencyContact[]
  allergies         Allergy[]
  chronicConditions ChronicCondition[]
  medications       Medication[]

  healthTracking  HealthTracking[]
  dailyHealthLogs DailyHealthLog[]

  wallets      Wallet[]
  transactions Transaction[]

  consentsGranted  Consent[] @relation("ConsentGrantedBy")
  consentsReceived Consent[] @relation("ConsentGrantedToUser")

  notifications     Notification[]
  messagesSent      Message[]          @relation("MessageSender")
  sessions          Session[]
  verificationCodes VerificationCode[]
  passwordResets    PasswordReset[]
  auditLogs         AuditLog[]

  professionalApplications ProfessionalApplication[] @relation("ProfessionalApplicant")
  professionalReviews      ProfessionalApplication[] @relation("ProfessionalReviewer")

  newsPosts     NewsPost[]     @relation("NewsPostAuthor")
  newsComments  NewsComment[]  @relation("NewsCommentAuthor")
  newsReactions NewsReaction[]
  newsReports   NewsReport[]   @relation("NewsReporter")
  newsReviews   NewsReport[]   @relation("NewsReportReviewer")

  featureOverrides FeatureUserOverride[]

  platformSubscriptions PlatformSubscription[] @relation("PlatformSubscriber")
  cmsUpdates            CmsContent[]           @relation("CmsUpdatedBy")

  patientConnections      PatientProfessionalConnection[] @relation("PatientConnections")
  professionalConnections PatientProfessionalConnection[] @relation("ProfessionalConnections")
  professionalAvailability ProfessionalAvailability[]
  messagesReceived         Message[]                      @relation("MessageRecipient")
  appointmentsAsProfessional Appointment[]                @relation("ProfessionalAppointments")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
}

model DailyHealthLog {
  dailyhealthlogid String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date

  // ═══════════════════════════════════════════════════════════
  // DAILY WELLNESS CHECK-IN
  // ═══════════════════════════════════════════════════════════

  mood          MoodLevel?
  sleepQuality  SleepQuality?
  stressLevel   StressLevel?
  energyLevel   EnergyLevel?
  activityLevel ActivityLevel?
  painLevel     PainLevel?

  painAreas String?
  notes     String?

  // ═══════════════════════════════════════════════════════════
  // ACTIVITY
  // Can be entered manually or synced automatically
  // ═══════════════════════════════════════════════════════════

  steps          Int   @default(0)
  distanceKm     Float @default(0)
  activeMinutes  Int   @default(0)
  caloriesBurned Int   @default(0)
  floorsClimbed  Int   @default(0)

  // ═══════════════════════════════════════════════════════════
  // BODY
  // ═══════════════════════════════════════════════════════════

  weightKg       Float?
  bodyFatPercent Float?
  muscleMassKg   Float?
  waterPercent   Float?
  bmi            Float?

  measurementRecordedAt DateTime?

  // ═══════════════════════════════════════════════════════════
  // NUTRITION
  // ═══════════════════════════════════════════════════════════

  caloriesIntake Int    @default(0)
  proteinG       Float?
  carbsG         Float?
  fatG           Float?
  fiberG         Float?
  sugarG         Float?

  // ═══════════════════════════════════════════════════════════
  // HYDRATION
  // ═══════════════════════════════════════════════════════════

  waterIntakeMl Int @default(0)
  waterGoalMl   Int @default(2000)

  hydrationStatus HydrationStatus @default(NOT_MET)

  // ═══════════════════════════════════════════════════════════
  // SLEEP
  // ═══════════════════════════════════════════════════════════

  sleepHours Float?
  sleepStart DateTime?
  sleepEnd   DateTime?

  // ═══════════════════════════════════════════════════════════
  // WELLNESS ACTIVITIES
  // ═══════════════════════════════════════════════════════════

  relaxationMinutes Int @default(0)
  meditationMinutes Int @default(0)

  // ═══════════════════════════════════════════════════════════
  // DAILY GOALS
  // ═══════════════════════════════════════════════════════════

  stepsGoal       Int        @default(10000)
  stepsGoalStatus GoalStatus @default(NOT_STARTED)

  waterGoalMlTarget Int        @default(2000)
  waterGoalStatus   GoalStatus @default(NOT_STARTED)

  activeMinutesGoal Int        @default(30)
  activeGoalStatus  GoalStatus @default(NOT_STARTED)

  sleepGoalHours  Float      @default(8)
  sleepGoalStatus GoalStatus @default(NOT_STARTED)

  caloriesGoal      Int?
  calorieGoalStatus GoalStatus @default(NOT_STARTED)

  // ═══════════════════════════════════════════════════════════
  // SOURCE
  // ═══════════════════════════════════════════════════════════

  source     DailyLogSource @default(MANUAL)
  deviceName String?

  // ═══════════════════════════════════════════════════════════
  // TIMESTAMPS
  // ═══════════════════════════════════════════════════════════

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ═══════════════════════════════════════════════════════════
  // RELATION
  // ═══════════════════════════════════════════════════════════

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  // ═══════════════════════════════════════════════════════════
  // INDEXES
  // ═══════════════════════════════════════════════════════════

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

// ═══════════════════════════════════════════════════════════
// 2. USER PROFILE
// ═══════════════════════════════════════════════════════════

model UserProfile {
  userprofileid String  @id @default(cuid())
  userId        String  @unique
  healthId      String? @unique

  middleName    String?
  nationalId    String? @unique
  nationality   String? @default("Somaliland")
  maritalStatus String?
  occupation    String?

  country     String? @default("Somaliland")
  region      String?
  city        String?
  district    String?
  addressLine String?
  postalCode  String?

  alternatePhone String?
  alternateEmail String?

  bloodType BloodType @default(UNKNOWN)
  height    Float?
  weight    Float?

  preferredLanguage String @default("so")
  preferredContact  String @default("SMS")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// 3. MEDICAL PROFILE
// ═══════════════════════════════════════════════════════════

model MedicalProfile {
  medicalprofileid String @id @default(cuid())
  userId           String @unique

  smokingStatus     String?
  alcoholUse        String?
  exerciseFrequency String?
  dietType          String?

  familyHistory          Json?
  surgicalHistory        Json?
  hospitalizationHistory Json?
  immunizationRecords    Json?

  organDonor Boolean @default(false)
  dnrStatus  Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// 4. EMERGENCY CONTACT
// ═══════════════════════════════════════════════════════════

model EmergencyContact {
  emergencycontactid String   @id @default(cuid())
  userId             String
  fullName           String
  relationship       String
  phone              String
  alternatePhone     String?
  email              String?
  address            String?
  isPrimary          Boolean  @default(false)
  priority           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
// 5. ALLERGY
// ═══════════════════════════════════════════════════════════

model Allergy {
  allergyid   String    @id @default(cuid())
  userId      String
  allergen    String
  type        String
  severity    String
  reaction    String?
  diagnosedAt DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// ═══════════════════════════════════════════════════════════
// 6. CHRONIC CONDITION
// ═══════════════════════════════════════════════════════════

model ChronicCondition {
  chronicconditionid String    @id @default(cuid())
  userId             String
  condition          String
  icdCode            String?
  diagnosedAt        DateTime?
  severity           String?
  isActive           Boolean   @default(true)
  isControlled       Boolean   @default(false)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([icdCode])
}

// ═══════════════════════════════════════════════════════════
// 7. MEDICATION
// ═══════════════════════════════════════════════════════════

model Medication {
  medicationid String    @id @default(cuid())
  userId       String
  name         String
  dosage       String
  frequency    String
  route        String?
  startedAt    DateTime
  endedAt      DateTime?
  isActive     Boolean   @default(true)
  prescribedBy String?
  reason       String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════
// 8. MEDICAL RECORD
// ═══════════════════════════════════════════════════════════

model MedicalRecord {
  medicalrecordid String  @id @default(cuid())
  userId          String
  recordType      String
  title           String
  description     String?
  diagnosis       String?
  treatment       String?
  notes           String?

  facilityName String?
  facilityId   String?
  doctorName   String?
  doctorId     String?

  recordDate  DateTime
  attachments Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId, recordDate])
  @@index([recordType])
}

// ═══════════════════════════════════════════════════════════
// 9. VITAL SIGN
// ═══════════════════════════════════════════════════════════

model VitalSign {
  vitalsignid String @id @default(cuid())
  userId      String

  temperature      Float?
  bloodPressureSys Int?
  bloodPressureDia Int?
  heartRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?
  weight           Float?
  height           Float?
  bmi              Float?

  source       String   @default("MANUAL")
  facilityName String?
  facilityId   String?
  notes        String?
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId, recordedAt])
}

// ═══════════════════════════════════════════════════════════
// 10. DIAGNOSIS
// ═══════════════════════════════════════════════════════════

model Diagnosis {
  diagnosisid String  @id @default(cuid())
  userId      String
  icdCode     String?
  description String
  category    String?
  isPrimary   Boolean @default(false)
  isChronic   Boolean @default(false)

  diagnosedBy  String?
  doctorId     String?
  facilityName String?
  facilityId   String?

  diagnosedAt DateTime
  resolvedAt  DateTime?
  isActive    Boolean   @default(true)

  notes       String?
  attachments Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([icdCode])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════
// 11. PRESCRIPTION
// ═══════════════════════════════════════════════════════════

model Prescription {
  prescriptionid   String @id @default(cuid())
  userId           String
  prescriptionCode String @unique

  medication   String
  dosage       String
  frequency    String
  duration     String
  route        String?
  instructions String?

  prescribedBy String?
  doctorId     String?
  facilityName String?
  facilityId   String?

  status PrescriptionStatus @default(PENDING)

  issuedAt     DateTime  @default(now())
  expiresAt    DateTime?
  dispensedAt  DateTime?
  dispensedBy  String?
  pharmacyName String?
  pharmacyId   String?

  notes       String?
  attachments Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([prescriptionCode])
}

// ═══════════════════════════════════════════════════════════
// 12. LAB ORDER
// ═══════════════════════════════════════════════════════════

model LabOrder {
  laborderid String @id @default(cuid())
  userId     String
  orderCode  String @unique

  testName     String
  testCategory String?
  instructions String?

  orderedBy    String?
  doctorId     String?
  facilityName String?
  facilityId   String?
  labName      String?
  labId        String?

  status LabOrderStatus @default(ORDERED)

  orderedAt         DateTime  @default(now())
  sampleCollectedAt DateTime?
  completedAt       DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [userid], onDelete: Cascade)
  result LabResult?

  @@index([userId])
  @@index([status])
  @@index([orderCode])
}

// ═══════════════════════════════════════════════════════════
// 13. LAB RESULT
// ═══════════════════════════════════════════════════════════

model LabResult {
  labresultid String @id @default(cuid())
  userId      String
  labOrderId  String @unique

  testName       String
  resultData     Json?
  resultText     String?
  interpretation String?
  isAbnormal     Boolean @default(false)
  isCritical     Boolean @default(false)

  labName    String?
  labId      String?
  verifiedBy String?
  verifiedAt DateTime?

  completedAt DateTime @default(now())
  attachments Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [userid], onDelete: Cascade)
  labOrder LabOrder @relation(fields: [labOrderId], references: [laborderid], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([isAbnormal])
}

// ═══════════════════════════════════════════════════════════
// 14. APPOINTMENT
// ═══════════════════════════════════════════════════════════

model Appointment {
  appointmentid   String @id @default(cuid())
  userId          String
  appointmentCode String @unique

  /// Patient who booked (userId) — professionalUserId is the clinician account when known
  professionalUserId String?

  facilityName String?
  facilityId   String?
  branchName   String?
  branchId     String?
  doctorName   String?
  doctorId     String?
  specialty    String?

  scheduledAt DateTime
  duration    Int      @default(30)

  reason      String?
  notes       String?
  meetingLink String?

  status AppointmentStatus @default(SCHEDULED)

  reminderSent Boolean   @default(false)
  reminderAt   DateTime?

  cancelledAt     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User  @relation(fields: [userId], references: [userid], onDelete: Cascade)
  professional User? @relation("ProfessionalAppointments", fields: [professionalUserId], references: [userid], onDelete: SetNull)

  @@index([userId, scheduledAt])
  @@index([professionalUserId, scheduledAt])
  @@index([status])
  @@index([appointmentCode])
}

// ═══════════════════════════════════════════════════════════
// 15. HEALTH TRACKING
// ═══════════════════════════════════════════════════════════

model HealthTracking {
  healthtrackingid String             @id @default(cuid())
  userId           String
  type             HealthTrackingType
  value            Float
  unit             String?
  notes            String?
  recordedAt       DateTime           @default(now())
  source           String             @default("MANUAL")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId, type, recordedAt])
}

// ═══════════════════════════════════════════════════════════
// 20. CONSENT
// ═══════════════════════════════════════════════════════════

model Consent {
  consentid String @id @default(cuid())
  userId    String

  grantedToTenantId   String?
  grantedToTenantName String?
  grantedToBranchId   String?
  grantedToUserId     String?
  grantedToUserName   String?

  scope  ConsentScope
  status ConsentStatus @default(PENDING)

  grantedAt     DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  purpose String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User  @relation("ConsentGrantedBy", fields: [userId], references: [userid], onDelete: Cascade)
  grantedToUser User? @relation("ConsentGrantedToUser", fields: [grantedToUserId], references: [userid], onDelete: SetNull)

  @@index([userId])
  @@index([grantedToUserId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
// 21. DOCUMENT
// ═══════════════════════════════════════════════════════════

model Document {
  documentid  String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String
  fileName    String
  fileUrl     String
  fileType    String
  fileSize    Int
  uploadedBy  String?
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

// ═══════════════════════════════════════════════════════════
// 22. WALLET
// ═══════════════════════════════════════════════════════════

model Wallet {
  walletid  String   @id @default(cuid())
  userId    String
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [userid], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
// 23. TRANSACTION
// ═══════════════════════════════════════════════════════════

model Transaction {
  transactionid String            @id @default(cuid())
  walletId      String
  userId        String
  amount        Decimal           @db.Decimal(12, 2)
  currency      String            @default("USD")
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  paymentMethod PaymentMethod?

  reference   String?
  description String?

  facilityName String?
  facilityId   String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [walletid], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// 24. NOTIFICATION
// ═══════════════════════════════════════════════════════════

model Notification {
  notificationid String              @id @default(cuid())
  userId         String
  title          String
  body           String
  type           NotificationType
  channel        NotificationChannel
  isRead         Boolean             @default(false)
  sentAt         DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// 25. MESSAGE
// ═══════════════════════════════════════════════════════════

model Message {
  messageid     String  @id @default(cuid())
  senderId      String
  recipientId   String?
  recipientType String?

  subject       String?
  body          String
  attachmentUrl String?
  isRead        Boolean   @default(false)
  readAt        DateTime?

  createdAt DateTime @default(now())

  sender    User  @relation("MessageSender", fields: [senderId], references: [userid], onDelete: Cascade)
  recipient User? @relation("MessageRecipient", fields: [recipientId], references: [userid], onDelete: SetNull)

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// 26. SESSION
// ═══════════════════════════════════════════════════════════

model Session {
  sessionid    String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  deviceInfo   String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  user         User?     @relation(fields: [userUserid], references: [userid], onDelete: Cascade)
  userUserid   String?

  @@index([userId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════
// 27. VERIFICATION PURPOSE
// ═══════════════════════════════════════════════════════════

enum VerificationPurpose {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
  TWO_FACTOR
  CHANGE_PHONE
  CHANGE_EMAIL
}

// ═══════════════════════════════════════════════════════════
// 28. VERIFICATION CODE
// ═══════════════════════════════════════════════════════════

model VerificationCode {
  verificationcodeid String @id @default(cuid())

  // Optional user relation
  userId String?
  phone  String?
  email  String?

  // OTP / verification code
  code String

  // Why this code was created
  purpose VerificationPurpose

  // Code lifecycle
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userUserid], references: [userid], onDelete: Cascade)
  userUserid String?

  @@index([userId])
  @@index([phone])
  @@index([email])
  @@index([purpose])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════
// 28. PASSWORD RESET
// ═══════════════════════════════════════════════════════════

model PasswordReset {
  passwordresetid String   @id @default(cuid())
  userId          String
  token           String   @unique
  expiresAt       DateTime
  isUsed          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ═══════════════════════════════════════════════════════════
// 29. AUDIT LOG
// ═══════════════════════════════════════════════════════════

model AuditLog {
  auditlogid String   @id @default(cuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [userid], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// 30. PROFESSIONAL PROFILE
// ═══════════════════════════════════════════════════════════

model ProfessionalProfile {
  professionalprofileid String @id @default(cuid())
  userId                String @unique

  professionalType Role

  /// Public URL slug e.g. dr-ahmed — never expose internal userid
  slug String? @unique

  licenseNumber  String?   @unique
  licenseExpiry  DateTime?
  certifications Json?

  specialization String?
  subSpecialty   String?
  qualifications Json?

  workplace    String?
  facilityName String?

  isPubliclyVisible Boolean @default(false)
  publicBio         String?
  publicPhotoUrl    String?
  publicCoverUrl    String?

  yearsOfExperience Int?
  languages         String[]

  consultationFee Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")

  rating        Float @default(0)
  totalReviews  Int   @default(0)
  totalPatients Int   @default(0)

  publicPhone String?
  publicEmail String?
  website     String?

  linkedin String?
  twitter  String?
  facebook String?

  isVerified Boolean   @default(false)
  isActive   Boolean   @default(true)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@index([professionalType])
  @@index([specialization])
  @@index([isPubliclyVisible])
  @@index([rating])
  @@index([slug])
}

// ═══════════════════════════════════════════════════════════
// PATIENT ↔ PROFESSIONAL CONNECTION (≠ medical consent)
// ═══════════════════════════════════════════════════════════

model PatientProfessionalConnection {
  id                 String @id @default(cuid())
  patientUserId      String
  professionalUserId String

  status      ConnectionStatus      @default(PENDING)
  requestedBy ConnectionRequestedBy

  reason String?

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      User @relation("PatientConnections", fields: [patientUserId], references: [userid], onDelete: Cascade)
  professional User @relation("ProfessionalConnections", fields: [professionalUserId], references: [userid], onDelete: Cascade)

  @@unique([patientUserId, professionalUserId])
  @@index([patientUserId, status])
  @@index([professionalUserId, status])
}

model ProfessionalAvailability {
  id                 String @id @default(cuid())
  professionalUserId String

  /// 0 = Sunday … 6 = Saturday
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional User @relation(fields: [professionalUserId], references: [userid], onDelete: Cascade)

  @@index([professionalUserId, dayOfWeek])
}

// ═══════════════════════════════════════════════════════════
// 31. FEATURE FLAGS / MODULE PERMISSIONS
// ═══════════════════════════════════════════════════════════

enum FeatureClient {
  ALL
  WEB
  MOBILE
}

model FeatureFlag {
  featureflagid String  @id @default(cuid())
  key           String  @unique
  label         String
  description   String?
  enabled       Boolean @default(true)
  client        FeatureClient @default(ALL)

  /// Role keys allowed when enabled, e.g. ["PATIENT","DOCTOR"]
  allowedRoles String[] @default([])

  /// Actions: read, create, update, delete, approve, manage
  actions String[] @default(["read"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overrides FeatureUserOverride[]

  @@index([enabled])
}

model FeatureUserOverride {
  featureuseroverrideid String @id @default(cuid())
  featureFlagId         String
  userId                String
  enabled               Boolean
  actions               String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [featureflagid], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([featureFlagId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
// 32. PROFESSIONAL APPLICATION (admin approval)
// ═══════════════════════════════════════════════════════════

enum ProfessionalApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFORMATION_REQUIRED
}

model ProfessionalApplication {
  professionalapplicationid String @id @default(cuid())
  userId                    String

  /// Human-readable application code e.g. APP-2026-000123
  applicationCode String? @unique

  requestedRole Role

  licenseNumber     String?
  licenseExpiry     DateTime?
  qualifications    String?
  specialization    String?
  subSpecialty      String?
  yearsOfExperience Int?
  languages         String[] @default([])
  facilityName      String?
  workplace         String?
  professionalBio   String?
  supportingDocs    Json?
  notes             String?

  status          ProfessionalApplicationStatus @default(PENDING)
  reviewNotes     String?
  rejectionReason String?
  reviewedById    String?
  submittedAt     DateTime                      @default(now())
  reviewedAt      DateTime?
  decidedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User  @relation("ProfessionalApplicant", fields: [userId], references: [userid], onDelete: Cascade)
  reviewedBy User? @relation("ProfessionalReviewer", fields: [reviewedById], references: [userid], onDelete: SetNull)

  @@index([userId, requestedRole])
  @@index([status])
  @@index([submittedAt])
}

// ═══════════════════════════════════════════════════════════
// 33. NEWS FEED
// ═══════════════════════════════════════════════════════════

enum NewsCategory {
  HEALTH_NEWS
  PUBLIC_HEALTH
  MEDICAL_EDUCATION
  HOSPITAL_UPDATES
  PROFESSIONAL_NEWS
  COMMUNITY_HEALTH
  GENERAL
  OFFICIAL_ANNOUNCEMENT
}

enum NewsPostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

enum NewsVisibility {
  PUBLIC
  AUTHENTICATED
  PROFESSIONALS
  PRIVATE
}

enum NewsReactionType {
  LIKE
  HELPFUL
  INSIGHTFUL
}

enum NewsReportReason {
  MISINFORMATION
  SPAM
  HARASSMENT
  IMPERSONATION
  INAPPROPRIATE
  PRIVACY_VIOLATION
  OTHER
}

enum NewsReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model NewsPost {
  newspostid    String         @id @default(cuid())
  authorId      String
  title         String
  content       String
  category      NewsCategory   @default(HEALTH_NEWS)
  status        NewsPostStatus @default(DRAFT)
  visibility    NewsVisibility @default(PUBLIC)
  coverImageUrl String?
  isOfficial    Boolean        @default(false)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  author    User           @relation("NewsPostAuthor", fields: [authorId], references: [userid], onDelete: Cascade)
  comments  NewsComment[]
  reactions NewsReaction[]
  reports   NewsReport[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([category])
}

model NewsComment {
  newscommentid   String    @id @default(cuid())
  postId          String
  authorId        String
  parentCommentId String?
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  post          NewsPost     @relation(fields: [postId], references: [newspostid], onDelete: Cascade)
  author        User         @relation("NewsCommentAuthor", fields: [authorId], references: [userid], onDelete: Cascade)
  parentComment NewsComment? @relation("CommentThread", fields: [parentCommentId], references: [newscommentid], onDelete: SetNull)
  replies       NewsComment[] @relation("CommentThread")
  reports       NewsReport[]

  @@index([postId, createdAt])
  @@index([authorId])
}

model NewsReaction {
  newsreactionid String           @id @default(cuid())
  postId         String
  userId         String
  reactionType   NewsReactionType @default(LIKE)
  createdAt      DateTime         @default(now())

  post NewsPost @relation(fields: [postId], references: [newspostid], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model NewsReport {
  newsreportid String           @id @default(cuid())
  postId       String?
  commentId    String?
  reporterId   String
  reason       NewsReportReason
  details      String?
  status       NewsReportStatus @default(OPEN)
  reviewedById String?
  reviewNotes  String?
  createdAt    DateTime         @default(now())
  reviewedAt   DateTime?

  post       NewsPost?    @relation(fields: [postId], references: [newspostid], onDelete: Cascade)
  comment    NewsComment? @relation(fields: [commentId], references: [newscommentid], onDelete: Cascade)
  reporter   User         @relation("NewsReporter", fields: [reporterId], references: [userid], onDelete: Cascade)
  reviewedBy User?        @relation("NewsReportReviewer", fields: [reviewedById], references: [userid], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([postId])
  @@index([commentId])
}

// ═══════════════════════════════════════════════════════════
// PLATFORM SUPER ADMIN — plans, subscriptions, homepage CMS
// ═══════════════════════════════════════════════════════════

enum PlanInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum PlatformSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model PlatformPlan {
  planid      String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  price       Decimal      @db.Decimal(12, 2)
  currency    String       @default("USD")
  interval    PlanInterval @default(MONTHLY)
  features    Json?
  isActive    Boolean      @default(true)
  isPublic    Boolean      @default(true)
  sortOrder   Int          @default(0)
  trialDays   Int          @default(0)
  maxUsers    Int?
  maxBranches Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscriptions PlatformSubscription[]

  @@index([isActive, isPublic, sortOrder])
}

model PlatformSubscription {
  subscriptionid   String                     @id @default(cuid())
  planId           String
  subscriberUserId String?
  organizationName String
  contactEmail     String?
  contactPhone     String?
  status           PlatformSubscriptionStatus @default(TRIALING)
  startsAt         DateTime                   @default(now())
  endsAt           DateTime?
  cancelledAt      DateTime?
  notes            String?
  metadata         Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  plan           PlatformPlan @relation(fields: [planId], references: [planid], onDelete: Restrict)
  subscriberUser User?        @relation("PlatformSubscriber", fields: [subscriberUserId], references: [userid], onDelete: SetNull)

  @@index([status, startsAt])
  @@index([planId])
  @@index([subscriberUserId])
}

model CmsContent {
  cmscontentid String   @id @default(cuid())
  key          String   @unique
  title        String?
  data         Json
  published    Boolean  @default(true)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  updatedBy User? @relation("CmsUpdatedBy", fields: [updatedById], references: [userid], onDelete: SetNull)

  @@index([published])
}
